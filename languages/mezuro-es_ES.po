#: src/Admin/SettingsPage.php:363
msgid "e.g. Men's T-Shirts"
msgstr "p.ej. Camisetas de hombre"

#: src/Admin/SettingsPage.php:367
msgid "Caption (optional)"
msgstr "Título (opcional)"

#: src/Admin/SettingsPage.php:370
msgid "e.g. All measurements in cm"
msgstr "p.ej. Todas las medidas en cm."

#: src/Admin/SettingsPage.php:372
msgid "Delete chart"
msgstr "Eliminar gráfico"

#: src/Admin/SettingsPage.php:372
msgid "Delete"
msgstr "Eliminar"

#: src/Admin/SettingsPage.php:387
msgid "Size"
msgstr "Tamaño"

#: src/Admin/SettingsPage.php:391
msgid "Add column"
msgstr "Añadir columna"

#: src/Admin/SettingsPage.php:415
