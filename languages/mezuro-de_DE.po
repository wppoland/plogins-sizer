#: src/Admin/SettingsPage.php:372
msgid "e.g. Men's T-Shirts"
msgstr "z.B. Herren-T-Shirts"

#: src/Admin/SettingsPage.php:376
msgid "Caption (optional)"
msgstr "Bildunterschrift (freiwillig)"

#: src/Admin/SettingsPage.php:379
msgid "e.g. All measurements in cm"
msgstr "z.B. Alle Maße in cm"

#: src/Admin/SettingsPage.php:381
msgid "Delete chart"
msgstr "Diagramm löschen"

#: src/Admin/SettingsPage.php:381
msgid "Delete"
msgstr "Löschen"

#: src/Admin/SettingsPage.php:396
msgid "Size"
msgstr "Größe"

